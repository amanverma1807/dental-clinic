# Supabase Configuration for Sai Dental Clinic
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Modern publishable key format (or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY)
